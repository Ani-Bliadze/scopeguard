# ScopeGuard configuration. Copy to .env (gitignored). Never commit real keys.
# deterministic = offline template planner + deterministic answer adapter (no network)
# live          = OpenAI (or Gemini) planner/answer when a key is configured; falls back to deterministic, visibly labeled
SCOPEGUARD_MODE=deterministic

# Optional live LLM provider (backend-only; never sent to the agent worker, browser, MCP servers or audit)
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=

# P1 features
SCOPEGUARD_ENABLE_APPROVALS=1
SCOPEGUARD_ENABLE_INJECTION_DEMO=0

# NOTE: the synthetic backend CRM credential is NOT configured here.
# `python -m scripts.reset_demo` generates it into .runtime/backend.env (gitignored).
